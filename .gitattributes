# Line endings are normalised on commit so that a checkout always gets the endings the platform expects,
# regardless of the contributor's `core.autocrlf` setting. Without this, a Windows contributor can commit
# `gradlew` with CRLF and the Linux CI then fails with "bad interpreter: /bin/sh^M".
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Archives must be stored untouched
*.jar binary
*.zip binary
*.png binary
*.webp binary

# Generated by the build, never worth diffing
gradle/wrapper/gradle-wrapper.jar binary
